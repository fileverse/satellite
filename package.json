{
  "name": "@fileverse/satellite",
  "version": "0.0.9",
  "description": "Satellite",
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./worker": "./dist/worker.js"
  },
  "bin": {
    "satellite": "dist/cli/index.js",
    "fileverse-satellite": "dist/cli/index.js",
    "ddctl": "dist/commands/index.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate:constants": "node scripts/generate-constants.cjs",
    "prebuild": "node scripts/generate-constants.cjs config/network.config.json",
    "prepublishOnly": "node scripts/generate-constants.cjs config/network.config.json && npm run typecheck && npm run clean && npm run build",
    "dev": "node scripts/generate-constants.cjs config/dev.network.config.json && tsx watch src/index.ts",
    "dev:worker": "node scripts/generate-constants.cjs config/dev.network.config.json && tsx watch src/worker.ts",
    "dev:cli": "tsx watch src/commands/index.ts",
    "dev:satellite": "tsx src/cli/index.ts",
    "start:api": "NODE_ENV=production node dist/index.js",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fileverse/content-processor": "^0.0.1",
    "@fileverse/crypto": "^0.0.21",
    "@stablelib/ed25519": "^2.0.2",
    "@ucans/ucans": "^0.12.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.5.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validation": "^4.1.1",
    "futoin-hkdf": "^1.5.3",
    "helmet": "^8.0.0",
    "js-base64": "^3.7.8",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "permissionless": "^0.3.4",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "short-uuid": "^6.0.3",
    "tweetnacl": "^1.0.3",
    "uuidv7": "^1.1.0",
    "viem": "^2.45.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "@types/multer": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
