{
  "name": "satellite",
  "version": "1.0.0",
  "description": "Satellite",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ddctl": "./dist/commands/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "postbuild": "node scripts/fix-esm-imports.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "dev:worker": "nodemon --watch src --ext ts --exec \"npm run build && node dist/worker.js\"",
    "dev:cli": "nodemon --watch src --ext ts --exec \"npm run build && node dist/commands/index.js\"",
    "start:api": "NODE_ENV=production node dist/index.js",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "npm run build",
    "migrate": "node --loader ts-node/esm scripts/run-migrations.ts",
    "migrate:create": "node --loader ts-node/esm scripts/generate-migration.ts",
    "migrate:rollback": "node --loader ts-node/esm scripts/rollback-migrations.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stablelib/ed25519": "^2.0.2",
    "@types/multer": "^2.0.0",
    "@ucans/ucans": "^0.12.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.5.0",
    "bullmq": "^5.66.0",
    "bunyan": "^1.8.15",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validation": "^4.1.1",
    "futoin-hkdf": "^1.5.3",
    "helmet": "^8.0.0",
    "ioredis": "^5.8.2",
    "js-base64": "^3.7.8",
    "localtunnel": "^2.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "permissionless": "^0.3.4",
    "redis": "^4.7.0",
    "short-uuid": "^6.0.3",
    "tweetnacl": "^1.0.3",
    "uuidv7": "^1.1.0",
    "viem": "^2.45.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bunyan": "^1.8.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/localtunnel": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
